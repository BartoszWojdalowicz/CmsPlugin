<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults public="true" />

        <service id="sylius_cms.menu.content_management" class="Sylius\CmsPlugin\Menu\ContentManagementMenuBuilder" decorates="sylius_admin_ui.knp.menu_builder">
            <argument type="service" id="sylius_cms.menu.content_management.inner" />
            <tag name="knp_menu.menu_builder" method="createMenu" alias="sylius_admin_ui.menu.sidebar" />
        </service>

        <service id="sylius_cms.event_listener.media_upload" class="Sylius\CmsPlugin\EventListener\MediaUploadListener">
            <argument type="service" id="sylius_cms.resolver.media_provider" />
            <tag name="kernel.event_listener" event="sylius_cms.media.pre_create" method="uploadMedia" />
            <tag name="kernel.event_listener" event="sylius_cms.media.pre_update" method="uploadMedia" />
        </service>
    </services>
</container>
